<?xml version="1.0"?>
<sdf version="1.6">
  <world name="nao6_model_inspection">
    <gravity>0 0 -9.81</gravity>
    <physics type="ode"><max_step_size>0.001</max_step_size></physics>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="plane">
        <collision name="surface"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></collision>
        <visual name="surface"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.15 0.4 0.15 1</ambient><diffuse>0.15 0.4 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Provisional ball parameters, not a calibrated rolling/kicking model. -->
    <model name="ball">
      <pose>0.4 0 0.075 0 0 0</pose>
      <link name="ball_link">
        <inertial><mass>0.04</mass><inertia><ixx>0.0000784</ixx><iyy>0.0000784</iyy><izz>0.0000784</izz></inertia></inertial>
        <collision name="ball_collision"><geometry><sphere><radius>0.07</radius></sphere></geometry></collision>
        <visual name="ball_visual"><geometry><sphere><radius>0.07</radius></sphere></geometry>
          <material><ambient>1 0.4 0 1</ambient><diffuse>1 0.4 0 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
