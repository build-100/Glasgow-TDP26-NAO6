<launch>
  <!-- Inspection only: collision_visual, simplified or full. -->
  <arg name="variant" default="collision_visual" />
  <arg name="gui" default="true" />
  <param name="robot_description" textfile="$(find nao6_description)/urdf/nao6_$(arg variant).urdf" />
  <node if="$(arg gui)" pkg="joint_state_publisher_gui" type="joint_state_publisher_gui" name="joint_state_publisher">
    <rosparam command="load" file="$(find nao6_description)/config/inspection_pose.yaml" />
  </node>
  <node unless="$(arg gui)" pkg="joint_state_publisher" type="joint_state_publisher" name="joint_state_publisher">
    <rosparam command="load" file="$(find nao6_description)/config/inspection_pose.yaml" />
  </node>
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" />
  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find nao6_description)/rviz/model.rviz" required="true" />
</launch>
