<launch>
  <arg name="wenao" default="auto" doc="Pinned Wenao checkout or auto for a verified local download"/>
  <arg name="robot_id" default="red1"/>
  <arg name="webots" default="webots"/>
  <group ns="$(arg robot_id)">
    <param name="robot_description" textfile="$(find nao6_description)/urdf/nao6_simplified.urdf"/>
    <node pkg="nao6_description" type="motion_workbench.py" name="whole_body_lab" output="screen"
          args="run --case ros --robot-id $(arg robot_id) --wenao &quot;$(arg wenao)&quot; --webots &quot;$(arg webots)&quot;"/>
  </group>
</launch>
