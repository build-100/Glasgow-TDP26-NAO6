<?xml version='1.0' encoding='utf-8'?>
<launch><arg name="publish_tf" default="true" /><group ns="red1"><param name="robot_description" textfile="$(find eng5325_global_demo_v4)/urdf/red1.urdf" /><node if="$(arg publish_tf)" pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="log"><param name="publish_frequency" value="20.0" /><remap from="joint_states" to="/joint_states_red1" /></node></group><group ns="red2"><param name="robot_description" textfile="$(find eng5325_global_demo_v4)/urdf/red2.urdf" /><node if="$(arg publish_tf)" pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="log"><param name="publish_frequency" value="20.0" /><remap from="joint_states" to="/joint_states_red2" /></node></group><group ns="red3"><param name="robot_description" textfile="$(find eng5325_global_demo_v4)/urdf/red3.urdf" /><node if="$(arg publish_tf)" pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="log"><param name="publish_frequency" value="20.0" /><remap from="joint_states" to="/joint_states_red3" /></node></group><group ns="red4"><param name="robot_description" textfile="$(find eng5325_global_demo_v4)/urdf/red4.urdf" /><node if="$(arg publish_tf)" pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="log"><param name="publish_frequency" value="20.0" /><remap from="joint_states" to="/joint_states_red4" /></node></group><group ns="blue1"><param name="robot_description" textfile="$(find eng5325_global_demo_v4)/urdf/blue1.urdf" /><node if="$(arg publish_tf)" pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="log"><param name="publish_frequency" value="20.0" /><remap from="joint_states" to="/joint_states_blue1" /></node></group><group ns="blue2"><param name="robot_description" textfile="$(find eng5325_global_demo_v4)/urdf/blue2.urdf" /><node if="$(arg publish_tf)" pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="log"><param name="publish_frequency" value="20.0" /><remap from="joint_states" to="/joint_states_blue2" /></node></group><group ns="blue3"><param name="robot_description" textfile="$(find eng5325_global_demo_v4)/urdf/blue3.urdf" /><node if="$(arg publish_tf)" pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="log"><param name="publish_frequency" value="20.0" /><remap from="joint_states" to="/joint_states_blue3" /></node></group><group ns="blue4"><param name="robot_description" textfile="$(find eng5325_global_demo_v4)/urdf/blue4.urdf" /><node if="$(arg publish_tf)" pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="log"><param name="publish_frequency" value="20.0" /><remap from="joint_states" to="/joint_states_blue4" /></node></group></launch>