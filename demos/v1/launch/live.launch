<?xml version='1.0' encoding='utf-8'?>
<launch><arg name="rviz" default="true" /><param name="use_sim_time" value="false" /><include file="$(find eng5325_global_demo)/launch/models.launch"><arg name="publish_tf" value="true" /></include><node pkg="eng5325_global_demo" type="field_map.py" name="fixed_pitch_map" output="log" /><node pkg="eng5325_global_demo" type="global_demo.py" name="global_demo" output="screen" /><node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz" args="-d $(find eng5325_global_demo)/rviz/nao6_global.rviz" output="log" /></launch>